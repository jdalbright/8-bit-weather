{
  "name": "8-bit-weather",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b && tsc -p tsconfig.server.json",
    "lint": "eslint .",
    "test": "vitest run && vitest run --config vitest.server.config.ts && node scripts/check-server.mjs",
    "test:e2e": "playwright test",
    "check:assets": "node scripts/check-assets.mjs",
    "dev:full": "vercel dev",
    "test:briefing:live": "RUN_LIVE_BRIEFING=true vitest run --config vitest.server.config.ts server/briefing.live.test.ts",
    "test:briefing:compare": "RUN_LIVE_BRIEFING_COMPARISON=true vitest run --config vitest.server.config.ts server/briefing.comparison.live.test.ts",
    "build:native": "tsc -b && vite build --mode native",
    "ios:sync": "npm run build:native && cap sync ios",
    "ios:open": "cap open ios",
    "ios:run": "npm run ios:sync && cap run ios",
    "check:native": "node scripts/check-native.mjs",
    "test:native-web": "playwright test --config playwright.native.config.ts",
    "test:widget": "sh scripts/test-widget.sh",
    "assets:widget": "node scripts/build-widget-assets.mjs"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.5.1",
    "@capacitor/geolocation": "^8.2.2",
    "@capacitor/ios": "^8.5.1",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/pixelify-sans": "^5.3.0",
    "maplibre-gl": "6.9.0",
    "openai": "^7.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.1",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "jsdom": "^26.1.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  }
}
