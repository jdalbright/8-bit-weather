{
  "name": "Weather briefing rate limit",
  "description": "Limit weather briefing generation to 10 POST requests per minute per IP.",
  "active": true,
  "conditionGroup": [
    {
      "conditions": [
        { "type": "path", "op": "eq", "value": "/api/weather-briefing" },
        { "type": "method", "op": "eq", "value": "POST" }
      ]
    }
  ],
  "action": {
    "mitigate": {
      "action": "rate_limit",
      "rateLimit": {
        "keys": ["ip"],
        "algo": "fixed_window",
        "limit": 10,
        "window": 60,
        "action": "rate_limit"
      }
    }
  }
}
