# Server only. Never prefix these variables with VITE_.
OPENAI_API_KEY=
OPENAI_WEATHER_MODEL=gpt-5.6-luna
# Enable locally/in preview for testing. Before public activation configure
# the /api/weather-briefing WAF rate limit described in README.md.
WEATHER_BRIEFING_ENABLED=false
# Server only: exact comma-separated native origins. Requires a backend deployment.
# WEATHER_BRIEFING_NATIVE_ORIGINS=capacitor://localhost
WEATHER_BRIEFING_NATIVE_ORIGINS=
# Public native OpenAI fallback setting. Apple Intelligence needs no endpoint.
# iOS defaults are in .env.native; override locally in .env.native.local.
# The server deployment must allow the configured native origin above.
VITE_NATIVE_BRIEFING_URL=
